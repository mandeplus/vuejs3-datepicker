{
  "name": "@mandeplus/vuejs3-datepicker",
  "version": "1.2.0",
  "description": "Datepicker component for Vue 3",
  "license": "MIT",
  "author": "M&E Plus (https://github.com/mandeplus)",
  "contributors": [
    "Shubhadip Maity (https://github.com/shubhadip)",
    "Vivek Singh (https://github.com/viveksinghup)"
  ],
  "homepage": "https://github.com/mandeplus/vuejs3-datepicker#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mandeplus/vuejs3-datepicker.git"
  },
  "bugs": {
    "url": "https://github.com/mandeplus/vuejs3-datepicker/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "build"
  ],
  "type": "module",
  "module": "./build/vuejs3-datepicker.js",
  "main": "./build/vuejs3-datepicker.umd.cjs",
  "types": "./build/components/datepicker/DatePickerComponent.vue.d.ts",
  "exports": {
    ".": {
      "types": "./build/components/datepicker/DatePickerComponent.vue.d.ts",
      "import": "./build/vuejs3-datepicker.js",
      "require": "./build/vuejs3-datepicker.umd.cjs"
    }
  },
  "scripts": {
    "dev": "vite --config vite.config.project.ts",
    "cz": "git-cz",
    "precommit": "lint-staged",
    "build": "vue-tsc && vite build --config vite.config.project.ts",
    "build:lib": "vue-tsc && vite build --config vite.config.lib.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint --cache --fix",
    "prepublishOnly": "npm run lint && npm run build:lib",
    "commit-message": "npm run commitlint -e -V",
    "prepare": "husky install"
  },
  "peerDependencies": {
    "vue": "^3.2.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^18.2.0",
    "@commitlint/config-conventional": "^18.1.0",
    "@types/node": "^20.8.10",
    "@types/prismjs": "^1.26.2",
    "@typescript-eslint/eslint-plugin": "^6.9.1",
    "@typescript-eslint/parser": "^6.9.1",
    "@vitejs/plugin-vue": "^4.2.3",
    "@vitest/ui": "^4.0.16",
    "@vue/eslint-config-airbnb": "^7.0.0",
    "@vue/eslint-config-prettier": "^8.0.0",
    "@vue/eslint-config-typescript": "^12.0.0",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.16",
    "cssnano": "^6.0.1",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^8.53.0",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-prettier": "^5.0.1",
    "eslint-plugin-vue": "^9.18.1",
    "git-cz": "^4.9.0",
    "happy-dom": "^20.0.11",
    "husky": "^8.0.0",
    "lint-staged": "^15.0.2",
    "postcss": "^8.4.31",
    "postcss-import": "^15.1.0",
    "postcss-nested": "^6.0.1",
    "postcss-simple-vars": "^7.0.1",
    "prismjs": "^1.30.0",
    "typescript": "^5.0.2",
    "vite": "^4.4.5",
    "vite-plugin-dts": "^3.9.1",
    "vite-plugin-libcss": "^1.1.1",
    "vitest": "^4.0.16",
    "vue": "^3.5.44",
    "vue-tsc": "^1.8.5"
  },
  "lint-staged": {
    "*.ts": "eslint --cache --fix",
    "*.vue": "eslint --cache --fix"
  },
  "keywords": [
    "vue",
    "vuejs",
    "vue 3",
    "javascript",
    "typescript",
    "vue-component",
    "date",
    "library",
    "month",
    "picker",
    "datepicker",
    "monthpicker"
  ],
  "config": {
    "commitizen": {
      "path": "git-cz"
    }
  }
}
